# Auto detect text files and perform LF normalization
* text=auto
*.sh text eol=lf
*.js text eol=lf
*.json text eol=lf
*.py text eol=lf
*.uc text eol=lf
*.ut text eol=lf
*.init text eol=lf
packages/*/files/* text eol=lf
packages/*/root/usr/libexec/* text eol=lf
packages/*/root/usr/share/rpcd/ucode/* text eol=lf
*.patch whitespace=-trailing-space,-space-before-tab
