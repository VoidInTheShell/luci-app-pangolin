#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

RUNTIME_DIR=/var/run/newt
RUNTIME_CONFIG="$RUNTIME_DIR/config.json"
HEALTH_FILE="$RUNTIME_DIR/healthy"

append_json_string() {
	local uci_name="$1"
	local json_name="$2"
	local value
	config_get value main "$uci_name"
	[ -n "$value" ] && json_add_string "$json_name" "$value"
}

append_json_bool() {
	local uci_name="$1"
	local json_name="$2"
	local value
	config_get_bool value main "$uci_name" 0
	json_add_boolean "$json_name" "$value"
}

append_json_int() {
	local uci_name="$1"
	local json_name="$2"
	local default="$3"
	local value
	config_get value main "$uci_name" "$default"
	json_add_int "$json_name" "$value"
}

append_array_value() {
	json_add_string "" "$1"
}

append_json_list() {
	local uci_name="$1"
	local json_name="$2"
	json_add_array "$json_name"
	config_list_foreach main "$uci_name" append_array_value
	json_close_array
}

write_runtime_config() {
	. /usr/share/libubox/jshn.sh

	umask 077
	mkdir -p "$RUNTIME_DIR" || return 1
	rm -f "$HEALTH_FILE" "$RUNTIME_DIR/started"

	json_init
	append_json_string endpoint endpoint
	local auth_mode
	config_get auth_mode main auth_mode credentials
	if [ "$auth_mode" = "provisioning" ]; then
		append_json_string provisioning_key provisioningKey
		append_json_string name name
	else
		append_json_string id id
		append_json_string secret secret
	fi
	append_json_string dns dns
	append_json_string log_level logLevel
	append_json_string updown_script updownScript
	append_json_string interface interface
	append_json_int mtu mtu 1280

	local port
	config_get port main port
	[ -n "$port" ] && json_add_int port "$port"

	append_json_bool native native
	append_json_bool native_main nativeMain
	append_json_string interface_main interfaceMain
	append_json_bool no_cloud noCloud
	append_json_string prefer_endpoint preferEndpoint
	append_json_list local_endpoint_interfaces localEndpointInterfaces

	append_json_string ping_interval pingInterval
	append_json_string ping_timeout pingTimeout
	append_json_string udp_proxy_idle_timeout udpProxyIdleTimeout

	append_json_bool disable_clients disableClients
	append_json_bool disable_ssh disableSsh
	append_json_bool enforce_hc_cert enforceHcCert
	json_add_string healthFile "$HEALTH_FILE"
	append_json_string blueprint_file blueprintFile
	append_json_string provisioning_blueprint_file provisioningBlueprintFile

	append_json_string docker_socket dockerSocket
	append_json_bool docker_enforce_network_validation dockerEnforceNetworkValidation

	append_json_string auth_daemon_key adPreSharedKey
	append_json_string auth_daemon_principals_file adPrincipalsFile
	append_json_string auth_daemon_ca_cert_path adCaCertPath
	append_json_bool auth_daemon_generate_random_password adGenerateRandomPassword

	append_json_string tls_client_cert tlsClientCertFile
	append_json_string tls_client_key tlsClientKey
	append_json_list tls_client_ca tlsClientCa
	append_json_string tls_private_key tlsClientCert

	append_json_bool metrics metrics
	append_json_bool otlp otlp
	append_json_string admin_addr metricsAdminAddr
	append_json_string region region
	append_json_bool metrics_async_bytes metricsAsyncBytes
	append_json_bool pprof pprof

	json_dump > "$RUNTIME_CONFIG" || return 1
	chmod 0600 "$RUNTIME_CONFIG"
}

validate_configuration() {
	local auth_mode endpoint id secret provisioning_key name
	config_get endpoint main endpoint
	config_get auth_mode main auth_mode credentials
	config_get id main id
	config_get secret main secret
	config_get provisioning_key main provisioning_key
	config_get name main name

	[ -n "$endpoint" ] || {
		echo "newt: Pangolin endpoint is required" >&2
		return 1
	}

	if [ "$auth_mode" = "provisioning" ]; then
		[ -n "$provisioning_key" ] && [ -n "$name" ] || {
			echo "newt: provisioning key and site name are required" >&2
			return 1
		}
	else
		[ -n "$id" ] && [ -n "$secret" ] || {
			echo "newt: Newt ID and secret are required" >&2
			return 1
		}
	fi
}

start_service() {
	local enabled threshold timeout retry stdout stderr

	config_load newt
	config_get_bool enabled main enabled 0
	[ "$enabled" -eq 1 ] || {
		echo "newt: disabled in /etc/config/newt"
		return 0
	}

	validate_configuration || return 1
	write_runtime_config || return 1

	config_get threshold main respawn_threshold 3600
	config_get timeout main respawn_timeout 5
	config_get retry main respawn_retry 5
	config_get_bool stdout main stdout 1
	config_get_bool stderr main stderr 1

	procd_open_instance main
	procd_set_param command /usr/libexec/newt-run
	# Newt 1.18.1 treats this value as an explicit self-update opt-out. Package
	# upgrades must remain under apk's control instead of replacing /usr/bin/newt.
	procd_set_param env NEWT_SYSTEM_SUBSTRATE=CONTAINER
	procd_set_param respawn "$threshold" "$timeout" "$retry"
	procd_set_param stdout "$stdout"
	procd_set_param stderr "$stderr"
	procd_set_param term_timeout 15
	procd_set_param file /etc/config/newt
	procd_close_instance

	local auth_mode
	config_get auth_mode main auth_mode credentials
	if [ "$auth_mode" = "provisioning" ]; then
		procd_open_instance credential_sync
		procd_set_param command /usr/libexec/newt-sync-credentials
		procd_set_param term_timeout 5
		procd_close_instance
	fi
}

stop_service() {
	rm -rf "$RUNTIME_DIR"
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger newt
}
