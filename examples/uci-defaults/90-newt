#!/bin/sh

# OpenWrt ImageBuilder first-boot template for Pangolin Newt.
#
# Set PANGOLIN_ENDPOINT for every image. Leave all credential values empty in
# public/generic images: the router stays disabled until it is configured in
# LuCI. For a private, per-device image, use either a unique one-time
# provisioning key and site name or an existing site's ID and secret.
#
# WARNING: a value embedded here remains recoverable from the original
# squashfs image even though OpenWrt removes this script from the writable
# overlay after it succeeds. Never put a reusable or fleet-wide secret here.

PANGOLIN_ENDPOINT='https://pangolin.example.com'
NEWT_PROVISIONING_KEY=''
NEWT_SITE_NAME=''
NEWT_ID=''
NEWT_SECRET=''

case "$PANGOLIN_ENDPOINT" in
	https://?*) ;;
	*)
		echo 'PANGOLIN_ENDPOINT must be a complete https:// URL.' >&2
		exit 1
		;;
esac

if [ -n "$NEWT_PROVISIONING_KEY" ] &&
   { [ -n "$NEWT_ID" ] || [ -n "$NEWT_SECRET" ]; }; then
	echo 'Set a provisioning key OR an ID/secret pair, not both.' >&2
	exit 1
fi
if { [ -n "$NEWT_ID" ] && [ -z "$NEWT_SECRET" ]; } ||
   { [ -z "$NEWT_ID" ] && [ -n "$NEWT_SECRET" ]; }; then
	echo 'NEWT_ID and NEWT_SECRET must be supplied together.' >&2
	exit 1
fi

[ -n "$NEWT_SITE_NAME" ] || NEWT_SITE_NAME="$(uci -q get system.@system[0].hostname)"
[ -n "$NEWT_SITE_NAME" ] || NEWT_SITE_NAME="newt-$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':')"

uci -q set newt.main='newt'
uci -q set newt.main.endpoint="$PANGOLIN_ENDPOINT"
if [ -n "$NEWT_PROVISIONING_KEY" ]; then
	uci -q set newt.main.auth_mode='provisioning'
	uci -q set newt.main.name="$NEWT_SITE_NAME"
	uci -q set newt.main.provisioning_key="$NEWT_PROVISIONING_KEY"
	uci -q delete newt.main.id || true
	uci -q delete newt.main.secret || true
	uci -q set newt.main.enabled='1'
elif [ -n "$NEWT_ID" ]; then
	uci -q set newt.main.auth_mode='credentials'
	uci -q set newt.main.id="$NEWT_ID"
	uci -q set newt.main.secret="$NEWT_SECRET"
	uci -q delete newt.main.provisioning_key || true
	uci -q delete newt.main.name || true
	uci -q set newt.main.enabled='1'
else
	uci -q set newt.main.auth_mode='credentials'
	uci -q delete newt.main.id || true
	uci -q delete newt.main.secret || true
	uci -q delete newt.main.provisioning_key || true
	uci -q delete newt.main.name || true
	uci -q set newt.main.enabled='0'
fi
uci -q commit newt

chmod 0600 /etc/config/newt
/etc/init.d/newt enable

# At first boot the network may not be ready yet. procd's respawn policy will
# reconnect once it is, and a disabled configuration remains a harmless no-op.
if [ -n "$NEWT_PROVISIONING_KEY" ] || [ -n "$NEWT_ID" ]; then
	/etc/init.d/newt restart
fi

exit 0
