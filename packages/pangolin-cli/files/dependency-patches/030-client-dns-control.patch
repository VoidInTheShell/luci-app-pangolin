+package dns
+
+import (
+	"context"
+	"net"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+func testHostProxy(t *testing.T) *DNSProxy {
+	t.Helper()
+	ctx, cancel := context.WithCancel(context.Background())
+	p := &DNSProxy{ctx: ctx, cancel: cancel, recordStore: NewDNSRecordStore()}
+	t.Cleanup(cancel)
+	if err := p.AddDNSRecord("printer.internal", net.ParseIP("10.22.33.44"), 0); err != nil {
+		t.Fatal(err)
+	}
+	return p
+}
+
+func TestHostListenerUDPAndTCPAndCleanup(t *testing.T) {
+	p := testHostProxy(t)
+	listenAddress := os.Getenv("PANGOLIN_TEST_DNS_ADDR")
+	if listenAddress == "" {
+		listenAddress = "127.0.0.1:0"
+	}
+	if err := p.StartHostListener(listenAddress); err != nil {
+		t.Fatal(err)
+	}
+	address := p.hostListeners.tcp.Listener.Addr().String()
+	defer p.StopHostListener()
+	for _, network := range []string{"udp", "tcp"} {
+		client := &dns.Client{Net: network, Timeout: time.Second}
+		query := new(dns.Msg).SetQuestion("printer.internal.", dns.TypeA)
+		response, _, err := client.Exchange(query, address)
+		if err != nil || response.Rcode != dns.RcodeSuccess || len(response.Answer) != 1 {
+			t.Fatalf("%s: response=%v error=%v", network, response, err)
+		}
+		if got := response.Answer[0].(*dns.A).A.String(); got != "10.22.33.44" {
+			t.Fatalf("%s returned %s", network, got)
+		}
+	}
+	p.StopHostListener()
+	p.StopHostListener()
+	udp, err := net.ListenPacket("udp", address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = udp.Close()
+	tcp, err := net.Listen("tcp", address)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = tcp.Close()
+}
+
+func TestHostListenerOccupiedPortAndLoopbackOnly(t *testing.T) {
+	p := testHostProxy(t)
+	if err := p.StartHostListener("0.0.0.0:953"); err == nil {
+		t.Fatal("accepted wildcard bind")
+	}
+	occupied, err := net.ListenPacket("udp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer occupied.Close()
+	address := occupied.LocalAddr().String()
+	if err := p.StartHostListener(address); err == nil {
+		t.Fatal("accepted occupied UDP port")
+	}
+	if p.hostListeners != nil {
+		t.Fatal("partial listener survived failure")
+	}
+	tcp, err := net.Listen("tcp", address)
+	if err != nil {
+		t.Fatalf("TCP port leaked after UDP failure: %v", err)
+	}
+	_ = tcp.Close()
+}
