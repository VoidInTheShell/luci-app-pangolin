#!/bin/sh
set -e
# OpenWrt's functions.sh intentionally reads unset optional environment values.
umask 077
cleanup() {
	result=$?
	if [ "$result" -ne 0 ] && [ -f /var/run/pangolin-auth/active ]; then
		printf '%s\n' '{"State":"error","Error":"Authentication did not complete. Try again."}' > /var/run/pangolin-auth/status.json
	fi
	rm -f /var/run/pangolin-auth/active
	/usr/libexec/pangolin-client-integration stop-auth >/dev/null 2>&1 || true
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
. /lib/functions.sh
config_load pangolin
config_get endpoint main endpoint https://app.pangolin.net
export PANGOLIN_CLI_CONFIG_DIR=/etc/pangolin/client
export PANGOLIN_CLI_DISABLE_UPDATE_CHECK=true
export PANGOLIN_CLI_DISABLE_COMPANION_MODE=true
umask 077
/usr/libexec/pangolin-client-integration sync
# No tokens, one-time codes or account details are copied into logd.
# The CLI atomically writes a separate token-free status file for LuCI.
/usr/bin/pangolin login "$endpoint" --web-state /var/run/pangolin-auth/status.json </dev/null >/dev/null 2>&1
