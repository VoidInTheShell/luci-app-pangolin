+package olm
+
+import "testing"
+
+func TestFullDNSDisableIgnoresServerOverride(t *testing.T) {
+	o := &Olm{tunnelConfig: TunnelConfig{DisableDNS: true}}
+	enable := true
+	o.applyDNSConfigUpdate(DNSConfigUpdate{OverrideDNS: &enable, TunnelDNS: &enable, UpstreamDNS: []string{"1.1.1.1:53"}})
+	if o.tunnelConfig.OverrideDNS || o.tunnelConfig.TunnelDNS || o.dnsProxy != nil {
+		t.Fatal("server push enabled DNS despite local disable")
+	}
+	if err := o.applyDNSOverride(true); err == nil {
+		t.Fatal("full disable allowed a system DNS override")
+	}
+}
+
+func TestHostListenerRejectsSystemDNSOverride(t *testing.T) {
+	o := &Olm{tunnelConfig: TunnelConfig{DNSListenAddr: "127.0.0.1:953"}}
+	enable := true
+	o.applyDNSConfigUpdate(DNSConfigUpdate{OverrideDNS: &enable})
+	if o.tunnelConfig.OverrideDNS {
+		t.Fatal("server push enabled system DNS override in host listener mode")
+	}
+	if err := o.applyDNSOverride(true); err == nil {
+		t.Fatal("host listener allowed a direct system DNS override")
+	}
+}
