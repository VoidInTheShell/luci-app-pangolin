#!/usr/bin/env ucode

'use strict';

import { chmod, readfile } from 'fs';
import { cursor } from 'uci';

const runtimeConfig = '/var/run/newt/config.json';

while (true) {
	sleep(2000);

	let raw = readfile(runtimeConfig);
	if (!raw)
		continue;

	let config;
	try {
		config = json(raw);
	} catch (e) {
		continue;
	}

	if (type(config?.id) != 'string' || !length(config.id) ||
	    type(config?.secret) != 'string' || !length(config.secret))
		continue;

	const uci = cursor();
	uci.load('newt');
	if (uci.get('newt', 'main', 'auth_mode') != 'provisioning') {
		uci.unload('newt');
		break;
	}

	uci.set('newt', 'main', 'id', config.id);
	uci.set('newt', 'main', 'secret', config.secret);
	uci.set('newt', 'main', 'auth_mode', 'credentials');
	uci.delete('newt', 'main', 'provisioning_key');
	uci.delete('newt', 'main', 'name');
	uci.save('newt');
	uci.commit('newt');
	uci.unload('newt');
	chmod('/etc/config/newt', 0600);
	break;
}
