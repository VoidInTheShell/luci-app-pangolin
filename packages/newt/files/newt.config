config newt 'main'
	option enabled '0'
	option endpoint 'https://app.pangolin.net'
	option auth_mode 'credentials'
	option id ''
	option secret ''
	option provisioning_key ''
	option name ''

	option log_level 'INFO'
	option dns '9.9.9.9'
	option mtu '1280'
	option port ''
	option interface 'pangolin'
	option native '0'
	option native_main '0'
	option interface_main 'pangolin'
	option no_cloud '0'
	option prefer_endpoint ''
	option ping_interval '15s'
	option ping_timeout '7s'
	option udp_proxy_idle_timeout '90s'

	option disable_clients '0'
	option disable_ssh '0'
	option enforce_hc_cert '0'
	option health_file '/var/run/newt/healthy'
	option updown_script ''
	option blueprint_file ''
	option provisioning_blueprint_file ''

	option docker_socket ''
	option docker_enforce_network_validation '0'

	option tls_client_cert ''
	option tls_client_key ''
	option tls_private_key ''

	option auth_daemon_key ''
	option auth_daemon_principals_file '/var/run/auth-daemon/principals'
	option auth_daemon_ca_cert_path '/etc/ssh/ca.pem'
	option auth_daemon_generate_random_password '0'

	option metrics '0'
	option otlp '0'
	option admin_addr '127.0.0.1:2112'
	option region ''
	option metrics_async_bytes '0'
	option pprof '0'

	option respawn_threshold '3600'
	option respawn_timeout '5'
	option respawn_retry '5'
	option stdout '1'
	option stderr '1'
