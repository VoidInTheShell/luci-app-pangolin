+package dns
+
+import (
+	"fmt"
+	"net"
+	"sync"
+	"time"
+
+	"github.com/miekg/dns"
+)
+
+// hostDNSListeners exposes the same resolver to host applications such as
+// dnsmasq. The utility-netstack listener remains private to Pangolin.
+type hostDNSListeners struct {
+	udp *dns.Server
+	tcp *dns.Server
+	wg  sync.WaitGroup
+}
+
+// StartHostListener binds an explicit loopback address for both UDP and TCP.
+// Acquire both sockets before serving so an occupied port fails atomically.
+func (p *DNSProxy) StartHostListener(address string) error {
+	if address == "" {
+		return nil
+	}
+	if p.hostListeners != nil {
+		return fmt.Errorf("host DNS listener is already running")
+	}
+	host, _, err := net.SplitHostPort(address)
+	if err != nil || !net.ParseIP(host).IsLoopback() {
+		return fmt.Errorf("host DNS listener must use a loopback IP and port")
+	}
+	tcp, err := net.Listen("tcp", address)
+	if err != nil {
+		return fmt.Errorf("listen TCP %s: %w", address, err)
+	}
+	// With port 0 (used by tests), UDP must use the port TCP actually got.
+	udp, err := net.ListenPacket("udp", tcp.Addr().String())
+	if err != nil {
+		_ = tcp.Close()
+		return fmt.Errorf("listen UDP %s: %w", address, err)
+	}
+	handler := dns.HandlerFunc(func(w dns.ResponseWriter, query *dns.Msg) {
+		response := p.resolveDNSQuery(query)
+		if _, ok := w.RemoteAddr().(*net.UDPAddr); ok {
+			size := uint16(512)
+			if opt := query.IsEdns0(); opt != nil && opt.UDPSize() > size {
+				size = opt.UDPSize()
+			}
+			response.Truncate(int(size))
+		}
+		_ = w.WriteMsg(response)
+	})
+	h := &hostDNSListeners{
+		udp: &dns.Server{PacketConn: udp, Handler: handler},
+		tcp: &dns.Server{Listener: tcp, Handler: handler, ReadTimeout: 5 * time.Second, WriteTimeout: 5 * time.Second},
+	}
+	ready := make(chan struct{}, 2)
+	startupErr := make(chan error, 2)
+	h.udp.NotifyStartedFunc = func() { ready <- struct{}{} }
+	h.tcp.NotifyStartedFunc = func() { ready <- struct{}{} }
+	p.hostListeners = h
+	h.wg.Add(2)
+	go func() {
+		defer h.wg.Done()
+		if err := h.udp.ActivateAndServe(); err != nil {
+			startupErr <- err
+		}
+	}()
+	go func() {
+		defer h.wg.Done()
+		if err := h.tcp.ActivateAndServe(); err != nil {
+			startupErr <- err
+		}
+	}()
+	for started := 0; started < 2; started++ {
+		select {
+		case <-ready:
+		case err := <-startupErr:
+			p.StopHostListener()
+			return fmt.Errorf("start host DNS listener: %w", err)
+		case <-time.After(2 * time.Second):
+			p.StopHostListener()
+			return fmt.Errorf("timeout starting host DNS listener")
+		}
+	}
+	return nil
+}
+
+// StopHostListener releases both sockets before closing the proxy netstack.
+func (p *DNSProxy) StopHostListener() {
+	h := p.hostListeners
+	if h == nil {
+		return
+	}
+	p.hostListeners = nil
+	_ = h.udp.Shutdown()
+	_ = h.tcp.Shutdown()
+	h.wg.Wait()
+}
