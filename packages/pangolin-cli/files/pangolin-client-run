#!/bin/sh
set -e
# OpenWrt configuration helpers read optional, unset environment variables.
. /lib/functions.sh
config_load pangolin
config_get client_auth main client_auth web
if [ "$client_auth" = machine ]; then
	config_get PANGOLIN_CLIENT_ID main id
	config_get PANGOLIN_CLIENT_SECRET main secret
	export PANGOLIN_CLI_CONFIG_DIR=/var/run/pangolin/config
else
	PANGOLIN_CLIENT_ID=''
	PANGOLIN_CLIENT_SECRET=''
	export PANGOLIN_CLI_CONFIG_DIR=/etc/pangolin/client
fi
config_get PANGOLIN_ENDPOINT main endpoint https://app.pangolin.net
config_get PANGOLIN_ORG main org
export PANGOLIN_CLIENT_ID PANGOLIN_CLIENT_SECRET PANGOLIN_ENDPOINT PANGOLIN_ORG
export PANGOLIN_CLI_DISABLE_UPDATE_CHECK=true
export PANGOLIN_CLI_DISABLE_COMPANION_MODE=true
export NEWT_SYSTEM_SUBSTRATE=CONTAINER
umask 077
mkdir -p "$PANGOLIN_CLI_CONFIG_DIR"
date +%s > /var/run/pangolin/client-started

config_get interface main interface pangolin
config_get_bool subnet_router main subnet_router 0
config_get_bool dns_enabled main dns_enabled 0
config_get dns_port main dns_port 953
config_get_bool prefer_local main prefer_local_routes 0
config_get log_level main log_level INFO
config_get mtu main mtu 1280

set -- up client --attach --interface-name "$interface" --mtu "$mtu" --log-level "$log_level" --override-dns=false
[ "$subnet_router" = 0 ] || set -- "$@" --subnet-router
[ "$prefer_local" = 0 ] || set -- "$@" --prefer-local-routes
if [ "$dns_enabled" = 1 ]; then
	set -- "$@" --dns-listen "127.0.0.1:$dns_port"
else
	set -- "$@" --disable-dns
fi
upstreams=''
add_upstream() { upstreams="${upstreams:+$upstreams,}$1"; }
config_list_foreach main dns_upstream add_upstream
[ -n "$upstreams" ] || upstreams='9.9.9.9:53,1.1.1.1:53'
set -- "$@" --upstream-dns "$upstreams"
exec /usr/bin/pangolin "$@"
