@@ -0,0 +1,56 @@
+package login
+
+import (
+	"encoding/json"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestWebStateIsPrivateAndContainsOnlyPairingData(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "state.json")
+	if err := writeWebState(path, webState{State: "pending", Code: "ABCD", URL: "https://example.test/auth/login/device?code=ABCD"}); err != nil {
+		t.Fatal(err)
+	}
+	info, err := os.Stat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Windows does not expose Unix permission bits.
+	if info.Mode().Perm()&0077 != 0 && os.PathSeparator != '\\' {
+		t.Fatalf("state is not private: %v", info.Mode())
+	}
+	data, _ := os.ReadFile(path)
+	var state map[string]any
+	if err := json.Unmarshal(data, &state); err != nil {
+		t.Fatal(err)
+	}
+	if state["Code"] != "ABCD" || state["State"] != "pending" {
+		t.Fatalf("unexpected state: %s", data)
+	}
+	if _, ok := state["Token"]; ok {
+		t.Fatal("token exposed")
+	}
+	if err := writeWebState("relative.json", webState{}); err == nil {
+		t.Fatal("accepted relative state path")
+	}
+}
+
+func TestWebOrganizationSelection(t *testing.T) {
+	orgs := []webOrg{{ID: "a"}, {ID: "b"}}
+	for _, tc := range []struct {
+		request, previous, want string
+		fail                    bool
+	}{
+		{"b", "a", "b", false}, {"", "a", "a", false},
+		{"", "", "", false}, {"unavailable", "", "", true},
+	} {
+		got, err := selectWebOrg(orgs, tc.request, tc.previous)
+		if got != tc.want || (err != nil) != tc.fail {
+			t.Fatalf("selection: %q, %v", got, err)
+		}
+	}
+	if got, _ := selectWebOrg(orgs[:1], "", ""); got != "a" {
+		t.Fatal("single organization not selected")
+	}
+}
