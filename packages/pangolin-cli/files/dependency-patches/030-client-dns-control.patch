+// resolveDNSQuery is shared by the utility netstack and loopback UDP/TCP
+// listeners, so aliases, domain matching and JIT behavior stay identical.
+func (p *DNSProxy) resolveDNSQuery(msg *dns.Msg) *dns.Msg {
+	if len(msg.Question) != 1 || msg.Response {
+		return new(dns.Msg).SetRcode(msg, dns.RcodeFormatError)
+	}
+	question := msg.Question[0]
+	var response *dns.Msg
+	if !p.matchesConfiguredDomains(question.Name) {
+		response = p.forwardToLocalDNS(msg)
+	} else {
+		if question.Qtype == dns.TypeA || question.Qtype == dns.TypeAAAA || question.Qtype == dns.TypePTR {
+			response = p.checkLocalRecords(msg, question)
+		}
+		if response != nil && p.jitHandler != nil &&
+			(question.Qtype == dns.TypeA || question.Qtype == dns.TypeAAAA) {
+			if siteID, ok := p.recordStore.GetSiteIdForDomain(question.Name); ok && siteID != 0 {
+				go p.jitHandler(siteID)
+			}
+		}
+		if response == nil {
+			response = p.forwardToUpstream(msg)
+		}
+	}
+	if response == nil {
+		return new(dns.Msg).SetRcode(msg, dns.RcodeServerFailure)
+	}
+	return response
 }
 
