@@ -0,0 +1,71 @@
+package login
+
+import (
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+)
+
+type webOrg struct {
+	ID   string
+	Name string
+}
+
+type webState struct {
+	State         string
+	Code          string
+	URL           string
+	ExpiresAt     int64
+	Error         string
+	Organizations []webOrg
+	SelectedOrg   string
+}
+
+// State is deliberately separate from accounts.json: it never contains a token
+// or OLM secret and is the only file exposed through the LuCI authentication RPC.
+func writeWebState(path string, state webState) error {
+	if !filepath.IsAbs(path) {
+		return errors.New("web state path must be absolute")
+	}
+	data, err := json.Marshal(state)
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(path), ".pairing-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(tmp.Name())
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		return err
+	}
+	return os.Rename(tmp.Name(), path)
+}
+
+func selectWebOrg(orgs []webOrg, requested, previous string) (string, error) {
+	for _, org := range orgs {
+		if requested != "" && org.ID == requested {
+			return requested, nil
+		}
+	}
+	if requested != "" {
+		return "", errors.New("requested organization is not available to this account")
+	}
+	for _, org := range orgs {
+		if previous != "" && org.ID == previous {
+			return previous, nil
+		}
+	}
+	if len(orgs) == 1 {
+		return orgs[0].ID, nil
+	}
+	return "", nil
+}
